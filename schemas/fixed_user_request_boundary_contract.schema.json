{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KOZO fixed user request boundary contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "architecture",
    "source_files",
    "execution_point",
    "request",
    "response",
    "kernel_shadows",
    "fixed_service",
    "copy_boundary",
    "page_permissions",
    "buffer_clearing",
    "marker_order",
    "marker_ownership",
    "failure_statuses",
    "halt_behavior",
    "claim_boundary",
    "non_goals"
  ],
  "properties": {
    "version": {"const": 0},
    "architecture": {"const": "x86_64"},
    "source_files": {"type": "object", "minProperties": 5},
    "execution_point": {"type": "object", "minProperties": 9},
    "request": {"$ref": "#/$defs/request"},
    "response": {"$ref": "#/$defs/response"},
    "kernel_shadows": {"type": "object"},
    "fixed_service": {"type": "object"},
    "copy_boundary": {"type": "object"},
    "page_permissions": {"type": "object"},
    "buffer_clearing": {"type": "object"},
    "marker_order": {"$ref": "#/$defs/nonEmptyStrings"},
    "marker_ownership": {"type": "object"},
    "failure_statuses": {"type": "object"},
    "halt_behavior": {"type": "object"},
    "claim_boundary": {"type": "object"},
    "non_goals": {"$ref": "#/$defs/nonEmptyStrings"}
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": ".*\\S.*"}
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "offset", "size"],
      "properties": {
        "name": {"type": "string", "pattern": ".*\\S.*"},
        "offset": {"type": "integer", "minimum": 0},
        "size": {"enum": [4, 8]}
      }
    },
    "request": {
      "type": "object",
      "required": ["name", "identifier", "version", "virtual_address", "page_offset", "size_bytes", "alignment_bytes", "physical_backing_symbol", "sequence", "payload", "flags", "reserved", "fields"],
      "properties": {
        "name": {"const": "FIXED_USER_RUNTIME_STATUS_REQUEST"},
        "identifier": {"const": 2},
        "version": {"const": 1},
        "virtual_address": {"const": "0x0000400000001000"},
        "page_offset": {"const": 0},
        "size_bytes": {"const": 40},
        "alignment_bytes": {"const": 8},
        "physical_backing_symbol": {"const": "user_probe_data_start"},
        "sequence": {"const": 1},
        "payload": {"const": 0},
        "flags": {"const": 0},
        "reserved": {"const": 0},
        "fields": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/field"}}
      }
    },
    "response": {
      "type": "object",
      "required": ["version", "request_identifier", "success_status", "virtual_address", "page_offset", "size_bytes", "alignment_bytes", "physical_backing_symbol", "fields"],
      "properties": {
        "version": {"const": 1},
        "request_identifier": {"const": 2},
        "success_status": {"const": 0},
        "virtual_address": {"const": "0x0000400000001080"},
        "page_offset": {"const": 128},
        "size_bytes": {"const": 88},
        "alignment_bytes": {"const": 8},
        "physical_backing_symbol": {"const": "user_probe_data_start"},
        "fields": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"$ref": "#/$defs/field"}}
      }
    }
  }
}
