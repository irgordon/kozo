    "red_zone": {
      "type": "boolean",
      "const": false
    },
    "panic": {
      "type": "string",
      "const": "abort"
    },
    "allocator": {
      "type": "boolean",
      "const": false
    },
    "sessions": {
      "type": "integer",
      "const": 2
    },
    "transitions_per_session": {
      "type": "integer",
      "const": 2
    },
    "marker_occurrences": {
      "type": "integer",
      "const": 52
