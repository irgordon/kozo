    "required_evidence": {
      "type": "array",
      "const": [
        "independent_pinned_object",
        "read_only_closed_relocations",
        "linked_entry_bytes_match_object",
        "rust_entries_in_user_rx_page",
        "exact_hardware_frame",
        "rust_request_and_response_validation",
        "two_completed_sessions",
        "hosted_qemu_controls"
      ],
      "items": {
        "type": "string"
      }
    },
    "non_goals": {
      "type": "array",
      "const": [
        "processes",
        "scheduler",
        "loader",
        "dynamic allocation",
        "new mappings",
        "new interrupt vectors",
        "public syscall ABI",
        "Windows runtime",
        "macOS runtime"
      ],
      "items": {
        "type": "string"
      }
    }
